{
  "manifest_version": 3,
  "name": "FlowCode Semantic Recorder for Edge",
  "short_name": "FlowCode",
  "version": "0.5.0",
  "description": "Captures user-approved browser actions for a local FlowCode recording.",
  "key": "",
  "minimum_chrome_version": "114",
  "incognito": "not_allowed",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "FlowCode browser capture",
    "default_popup": "popup.html"
  }
}
