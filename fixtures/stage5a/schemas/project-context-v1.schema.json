{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "not-indexed",
            "target-missing",
            "stale-code"
          ]
        },
        "readOnly": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "projectId",
        "reason",
        "readOnly"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "available"
        },
        "target": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "web-test",
                "browser-automation"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "entry": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 1024
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "contentHash"
              ],
              "additionalProperties": false
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "pageObjects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "contentHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "contentHash"
                ],
                "additionalProperties": false
              }
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "contentHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "contentHash"
                ],
                "additionalProperties": false
              }
            },
            "codeHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "assertion",
                      "wait",
                      "unknown"
                    ]
                  },
                  "file": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "file",
                  "line",
                  "summary"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "id",
            "projectId",
            "kind",
            "name",
            "entry",
            "symbol",
            "pageObjects",
            "fixtures",
            "codeHash",
            "assertions"
          ],
          "additionalProperties": false
        },
        "readOnly": {
          "type": "boolean",
          "const": true
        },
        "redacted": {
          "type": "boolean",
          "const": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "target",
        "readOnly",
        "redacted",
        "summary"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "Structural interchange schema. Host MUST additionally run the corresponding Zod graph/refinement validator and Blueprint content-hash verifier; this JSON Schema alone does not establish execution readiness or privacy."
}
