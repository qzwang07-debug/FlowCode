{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "binding": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "blueprint": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "environmentProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "environmentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "codeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parametersHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "blueprint",
        "projectId",
        "targetId",
        "environmentProfileId",
        "environmentHash",
        "codeHash",
        "planHash",
        "parametersHash"
      ],
      "additionalProperties": false
    },
    "leaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "type": "string",
      "enum": [
        "preparing",
        "running",
        "paused",
        "waiting-user",
        "interrupted",
        "succeeded",
        "failed",
        "canceled",
        "timed-out"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "unknown-result"
            ]
          },
          "effect": {
            "type": "string",
            "enum": [
              "read-only",
              "idempotent-write",
              "business-submit"
            ]
          },
          "resultHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "state",
          "effect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "binding",
    "leaseId",
    "updatedAt",
    "phase",
    "steps"
  ],
  "additionalProperties": false,
  "$comment": "Structural interchange schema. Host MUST additionally run the corresponding Zod graph/refinement validator and Blueprint content-hash verifier; this JSON Schema alone does not establish execution readiness or privacy."
}
