{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "recordingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "phase": {
      "type": "string",
      "enum": [
        "analysis",
        "planning",
        "editing",
        "validating",
        "waiting-user",
        "review-ready",
        "interrupted",
        "succeeded",
        "failed",
        "canceled"
      ]
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "schemaContractVersion": {
      "type": "number",
      "const": 2
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "recordingId",
    "blueprint",
    "phase",
    "updatedAt",
    "promptVersion",
    "schemaContractVersion",
    "provider",
    "model"
  ],
  "additionalProperties": false,
  "$comment": "Structural interchange schema. Host MUST additionally run the corresponding Zod graph/refinement validator and Blueprint content-hash verifier; this JSON Schema alone does not establish execution readiness or privacy."
}
